# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Node (only here for the npm scripts convenience)
node_modules/
package-lock.json
packages/*/dist/
packages/*/node_modules/
examples/*/node_modules/
examples/*/.next/
examples/*/dist/
site/.next/
site/node_modules/

# Editor
.vscode/
.idea/

# Secrets / local config
.env
.env.*
!.env.example

# Generated fonts — regenerate with scripts/generate_font.py
public/fonts/*

# V3 benchmark heavy artifacts (regeneratable)
benchmarks/v3/data/
benchmarks/v3/adapters/
benchmarks/v3/results/embeddings_*.npz
benchmarks/v3/results/_crawler_site/
benchmarks/v3/kenlm_model/

# V5 benchmark — regenerate per-condition jsonl + adapters; keep probes + budget + eval JSONs (audit trail)
benchmarks/v5/data/clean100/
benchmarks/v5/data/m15en_optimized_10/
benchmarks/v5/data/m15_multi_noun_only_10/
benchmarks/v5/data/eval_wiki_holdout.jsonl
benchmarks/v5/adapters/

# V6 benchmark — regenerate per-condition jsonl + adapters + heavy embeddings; keep probes + mappings + eval JSONs (audit trail)
benchmarks/v6/adapters/
benchmarks/v6/data/m15en_optimized_10/
benchmarks/v6/data/m17near_*/
benchmarks/v6/data/eval_wiki_holdout.jsonl
benchmarks/v6/data/numberbatch_en.tsv
benchmarks/v6/data/numberbatch-en-*.txt.gz
benchmarks/v6/data/_datamuse_cache.json
benchmarks/v6/data/brysbaert_concreteness.tsv*

# Claude Code session artifacts
.claude/

# V4 work artifacts (intermediates from white paper assembly)
benchmarks/v4/work/

# V7 benchmark — regenerate pair/reject candidate dumps + heavy embeddings + LM caches; keep audit JSONs/metrics
benchmarks/v7/data/embeddings/
benchmarks/v7/data/lms/
benchmarks/v7/data/pairs_v7_alpha_v*.json
benchmarks/v7/data/rejects_v7_alpha_v*.json
# ...but ALWAYS track the ONE shipped production mapping (v18 = v15_0_1_0_0_0_0, 11,988 pairs).
# It is the shipping artifact; keeping it in git means no machine can silently lose it again.
!benchmarks/v7/data/pairs_v7_alpha_v15_0_1_0_0_0_0.json

# V8 benchmark — keep scripts/reports/result-JSONs; ignore heavy regenerable corpora / LMs / adapters
benchmarks/v8/data/corpora/
benchmarks/v8/data/lms/
benchmarks/v8/data/splits/
benchmarks/v8/data/phase5_train/
benchmarks/v8/data/phase5_test/
benchmarks/v8/phase5_finetune/adapters/
benchmarks/v8/**/*.arpa
benchmarks/v8/**/*.binary
benchmarks/v8/**/*.safetensors
benchmarks/v8/**/*.jsonl
benchmarks/v8/**/*.txt

# Temporary preview server artifacts
shieldfont_test/
site/tsconfig.tsbuildinfo
site/out/

# Root-level Next.js build cache (only site/ should hold Next state)
/.next/
