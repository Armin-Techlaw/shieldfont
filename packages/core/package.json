{
  "name": "@shieldfont/core",
  "version": "0.1.0",
  "description": "Core encoding/decoding logic for ShieldFont — the AI-scraping-resistant web font",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mappings/alpha": {
      "import": "./dist/mappings/alpha.js",
      "types": "./dist/mappings/alpha.d.ts"
    },
    "./mappings/beta": {
      "import": "./dist/mappings/beta.js",
      "types": "./dist/mappings/beta.d.ts"
    },
    "./mappings/gamma": {
      "import": "./dist/mappings/gamma.js",
      "types": "./dist/mappings/gamma.d.ts"
    },
    "./mappings/m15en": {
      "import": "./dist/mappings/m15en.js",
      "types": "./dist/mappings/m15en.d.ts"
    }
  },
  "files": ["dist", "src/mappings", "MANIFEST.json", "LICENSE", "LICENSE-FONTS", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-mappings.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["shieldfont", "encoding", "anti-scraping"],
  "license": "AGPL-3.0-or-later",
  "author": "Isaque Seneda and Gabriel Abrucio",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaqueseneda/shieldfont.git",
    "directory": "packages/core"
  },
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/node": "^20.10.0"
  }
}
