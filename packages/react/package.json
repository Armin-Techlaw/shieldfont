{
  "name": "@shieldfont/react",
  "version": "0.1.1",
  "description": "ShieldFont React component \u2014 encodes in Node so your original text never ships to the browser",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts",
    "AGENTS.md",
    "LICENSE",
    "LICENSE-FONTS",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "shieldfont",
    "react",
    "server-component",
    "anti-scraping"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Isaque Seneda and Gabriel Abrucio",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaqueseneda/shieldfont.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@shieldfont/core": "^0.1.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
